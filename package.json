{
  "name": "study-spot-finder",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "types": "supabase gen types typescript --project-id pgialmtoulnmfrivjqeq > src/types/database.types.ts",
    "db:dump": "supabase db dump --linked -s public -f supabase/schema.sql",
    "db:sync": "npm run types && npm run db:dump"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-navigation/native": "^7.4.1",
    "@supabase/supabase-js": "^2.117.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "fuse.js": "^7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
